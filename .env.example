# Credentials for TP-Link Easy Smart switches. Keep this file local.
TPLINK_SWITCH_USER=admin
TPLINK_SWITCH_PASSWORD=change-me

# Easy Smart polling backend. "python" is the default and uses requests.Session,
# matching the proven essstat behaviour. "node" is retained as experimental.
# TPLINK_EASYSMART_BACKEND=python
# PYTHON3=python3

# Optional TP-Link Archer MR-series local LTE telemetry. Enable cellularRouter in
# site.local.json, then use the Local Password from the router web interface.
# TPLINK_ROUTER_USER=admin
# TPLINK_ROUTER_PASSWORD=change-me
# MR600_PYTHON=/home/pi/network-supervisor/.venv/bin/python

# Optional paths / listening address.
SITE_CONFIG=./site.local.json
DATA_DIR=/mnt/ssd/network-supervisor
WEB_HOST=0.0.0.0
WEB_PORT=8790

# Native OpenAI diagnosis (human-initiated only).
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-5.6
# OPENAI_REASONING_EFFORT=medium

# Optional generic AI HTTP hook instead of OpenAI.
# AI_PROVIDER=generic
# AI_URL=https://example.invalid/diagnose
# AI_BEARER_TOKEN=
# AI_TIMEOUT_MS=60000
