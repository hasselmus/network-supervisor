[Unit]
Description=Small topology-aware home network supervisor
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/ssd

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/network-supervisor
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env node /home/pi/network-supervisor/src/index.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
