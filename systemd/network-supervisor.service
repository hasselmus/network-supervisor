[Unit]
Description=Small topology-aware home network supervisor
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/ssd

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/network-supervisor
ExecStart=/usr/bin/node /home/pi/network-supervisor/src/index.mjs
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
